generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED
}

enum ScopeType {
  SELF
  TEAM
  ALL
}

enum TeamStatus {
  ACTIVE
  INACTIVE
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  LEFT
}

enum EmployeeGroupStatus {
  ACTIVE
  INACTIVE
}

enum OrgSyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum OrgSyncItemStatus {
  SUCCESS
  SKIPPED
  FAILED
}

enum KpiSyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
  SKIPPED
}

enum KpiSyncItemStatus {
  SUCCESS
  SKIPPED
  FAILED
  CONFLICT
}

enum KpiSyncRecordKind {
  TARGET
  ACTUAL
}

enum KpiValueDataSource {
  MANUAL
  AUTOMATION_GEN_VIDEO
}

enum KpiDataSource {
  INTERNAL
  AUTOMATION_GEN_VIDEO
}

// CANCELLED là hủy mềm để giữ lịch sử — dữ liệu nghiệp vụ không bao giờ xóa cứng.
enum KpiAssignmentStatus {
  ASSIGNED
  CANCELLED
}

enum SelfConfirmationStatus {
  DRAFT
  CONFIRMED
}

enum LeaderReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollPeriodStatus {
  DRAFT
  OPEN
  IN_REVIEW
  CLOSED
}

enum RewardRuleSetStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SalaryRecordStatus {
  PENDING
  WARNING
  LOCKED
  SUPERSEDED
}

enum SalaryComponentSource {
  MANUAL
  SYSTEM
}

enum TrafficPlatform {
  TIKTOK
  FACEBOOK
  YOUTUBE
  INSTAGRAM
}

enum ProposalType {
  KPI_ITEM
  OKR
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                    String     @id @default(uuid()) @db.Uuid
  employeeId            Int?       @unique @map("employee_id")
  email                 String     @unique @db.VarChar(255)
  passwordHash          String     @map("password_hash")
  fullName              String     @map("full_name") @db.VarChar(200)
  status                UserStatus @default(ACTIVE)
  lastLoginAt           DateTime?  @map("last_login_at") @db.Timestamptz()
  refreshTokenHash      String?    @unique @map("refresh_token_hash")
  refreshTokenExpiresAt DateTime?  @map("refresh_token_expires_at") @db.Timestamptz()
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  employee                      Employee?               @relation(fields: [employeeId], references: [id])
  userRoles                     UserRole[]
  uploadedFiles                 FileAttachment[]
  openedPeriods                 PayrollPeriod[]
  actorAuditLogs                AuditLog[]
  notifications                 Notification[]
  triggeredOrgSyncRuns          OrgSyncRun[]
  triggeredKpiSyncRuns          KpiSyncRun[]
  createdRewardRuleSets         RewardRuleSet[]
  createdBaseSalaryHistories    BaseSalaryHistory[]
  createdEmployeeKpiRewardRates EmployeeKpiRewardRate[]
  createdKpiGroups              KpiGroup[]
  createdKpiPeriodTargets       KpiPeriodTarget[]
  createdEmployeeKpiTargets     EmployeeKpiTarget[]
  overriddenEmployeeKpiTargets  EmployeeKpiTarget[]     @relation("KpiTargetOverriddenBy")
  assignedKpiAssignments        EmployeeKpiAssignment[] @relation("KpiAssignmentAssignedBy")
  selfConfirmedKpiActuals       EmployeeKpiActual[]     @relation("KpiActualSelfConfirmedBy")
  leaderReviewedKpiActuals      EmployeeKpiActual[]     @relation("KpiActualLeaderReviewedBy")
  overriddenKpiActuals          EmployeeKpiActual[]     @relation("KpiActualOverriddenBy")
  selfConfirmedOkrs             EmployeeOkr[]           @relation("OkrSelfConfirmedBy")
  leaderReviewedOkrs            EmployeeOkr[]           @relation("OkrLeaderReviewedBy")
  reviewedProposals             KpiOkrProposal[]        @relation("ProposalReviewedBy")
  enteredRevenueRecords         EmployeeRevenueRecord[] @relation("RevenueEnteredBy")
  updatedRevenueRecords         EmployeeRevenueRecord[] @relation("RevenueUpdatedBy")
  selfConfirmedTrafficRecords   EmployeeTrafficRecord[] @relation("TrafficSelfConfirmedBy")
  leaderReviewedTrafficRecords  EmployeeTrafficRecord[] @relation("TrafficLeaderReviewedBy")
  calculatedSalaryRecords       SalaryRecord[]          @relation("SalaryCalculatedBy")
  approvedSalaryRecords         SalaryRecord[]          @relation("SalaryApprovedBy")
  createdSalaryComponents       SalaryRecordComponent[]

  @@index([createdAt(sort: Desc)])
  @@map("users")
}

model Department {
  id        Int              @id @default(autoincrement())
  code      String           @unique @db.VarChar(50)
  name      String           @db.VarChar(150)
  status    DepartmentStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  teams          Team[]
  employeeGroups EmployeeGroup[]

  @@map("departments")
}

model EmployeeGroup {
  id   Int    @id @default(autoincrement())
  code String @unique @db.VarChar(50)
  name String @db.VarChar(150)

  description      String?
  // NULL = nhóm dùng chung mọi phòng ban; có giá trị = chỉ chọn được trong phòng ban đó.
  departmentId     Int?     @map("department_id")
  // Vai trò (scope SELF) tự gán cho tài khoản của nhân sự thuộc nhóm. NULL = không suy vai trò nào.
  defaultRoleId    Int?     @map("default_role_id")
  // Từ khóa ĐÃ BỎ DẤU và VIẾT HOA, dùng để đoán nhóm từ chức danh. Rỗng = không bao giờ tự đoán.
  jobTitleKeywords String[] @default([]) @map("job_title_keywords")

  status    EmployeeGroupStatus @default(ACTIVE)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz()

  department  Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  defaultRole Role?       @relation(fields: [defaultRoleId], references: [id], onDelete: SetNull)
  employees   Employee[]  @relation("EmployeeEmployeeGroups")
  kpiGroups   KpiGroup[]  @relation("KpiGroupEmployeeGroups")

  @@index([departmentId])
  @@map("employee_groups")
}

model Team {
  id           Int        @id @default(autoincrement())
  code         String     @unique @db.VarChar(50)
  name         String     @db.VarChar(150)
  status       TeamStatus @default(ACTIVE)
  departmentId Int        @map("department_id")
  sourceSystem String?    @map("source_system") @db.VarChar(30)
  externalId   String?    @unique @map("external_id") @db.Uuid
  lastSyncedAt DateTime?  @map("last_synced_at") @db.Timestamptz()
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  department                Department                          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  employees                 Employee[]
  employeeMemberships       EmployeeTeamMembership[]
  periodMembershipSnapshots PayrollPeriodEmployeeTeamSnapshot[]
  kpiAssignments            EmployeeKpiAssignment[]
  kpiTargets                EmployeeKpiTarget[]
  kpiActuals                EmployeeKpiActual[]
  kpiSyncItems              KpiSyncRunItem[]
  salaryKpiItems            SalaryRecordKpiItem[]
  scopedUserRoles           UserRole[]
  kpiGroups                 KpiGroup[]                          @relation("KpiGroupTeams")

  @@index([departmentId])
  @@map("teams")
}

model Employee {
  id                Int              @id @default(autoincrement())
  employeeCode      String           @unique @map("employee_code") @db.VarChar(50)
  fullName          String           @map("full_name") @db.VarChar(200)
  jobTitle          String           @map("job_title") @db.VarChar(100)
  teamId            Int              @map("team_id")
  leaderEmployeeId  Int?             @map("leader_employee_id")
  managerEmployeeId Int?             @map("manager_employee_id")
  employmentStatus  EmploymentStatus @default(ACTIVE) @map("employment_status")
  joinedAt          DateTime?        @map("joined_at") @db.Date
  leftAt            DateTime?        @map("left_at") @db.Date
  sourceSystem      String?          @map("source_system") @db.VarChar(30)
  externalId        String?          @unique @map("external_id") @db.Uuid
  lastSyncedAt      DateTime?        @map("last_synced_at") @db.Timestamptz()
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  team           Team            @relation(fields: [teamId], references: [id])
  employeeGroups EmployeeGroup[] @relation("EmployeeEmployeeGroups")
  leader         Employee?       @relation("EmployeeLeader", fields: [leaderEmployeeId], references: [id])
  manager        Employee?       @relation("EmployeeManager", fields: [managerEmployeeId], references: [id])

  ledEmployees     Employee[] @relation("EmployeeLeader")
  managedEmployees Employee[] @relation("EmployeeManager")
  user             User?

  payrollPeriodSnapshots     PayrollPeriodEmployeeSnapshot[]
  targetAuditLogs            AuditLog[]
  orgSyncItems               OrgSyncRunItem[]
  kpiSyncItems               KpiSyncRunItem[]
  baseSalaryHistories        BaseSalaryHistory[]
  kpiRewardRates             EmployeeKpiRewardRate[]
  kpiAssignments             EmployeeKpiAssignment[]
  kpiTargets                 EmployeeKpiTarget[]
  kpiActuals                 EmployeeKpiActual[]
  okrs                       EmployeeOkr[]
  proposals                  KpiOkrProposal[]
  revenueRecords             EmployeeRevenueRecord[]
  trafficRecords             EmployeeTrafficRecord[]
  salaryRecords              SalaryRecord[]
  externalIdentities         ExternalEmployeeIdentity[]
  teamMemberships            EmployeeTeamMembership[]            @relation("MembershipEmployee")
  ledTeamMemberships         EmployeeTeamMembership[]            @relation("MembershipLeader")
  managedTeamMemberships     EmployeeTeamMembership[]            @relation("MembershipManager")
  periodTeamSnapshots        PayrollPeriodEmployeeTeamSnapshot[] @relation("PeriodTeamSnapshotEmployee")
  periodLedTeamSnapshots     PayrollPeriodEmployeeTeamSnapshot[] @relation("PeriodTeamSnapshotLeader")
  periodManagedTeamSnapshots PayrollPeriodEmployeeTeamSnapshot[] @relation("PeriodTeamSnapshotManager")

  @@index([teamId])
  @@index([leaderEmployeeId])
  @@index([managerEmployeeId])
  @@map("employees")
}

// Khóa nhận diện nhân sự khi sync là (sourceSystem, externalUserId) — mã/email do nguồn gửi lên
// chỉ là metadata tham khảo, có thể đổi mà không được làm mất liên kết.
model ExternalEmployeeIdentity {
  id                   Int      @id @default(autoincrement())
  employeeId           Int      @map("employee_id")
  sourceSystem         String   @map("source_system") @db.VarChar(30)
  externalUserId       String   @map("external_user_id") @db.Uuid
  externalEmployeeCode String?  @map("external_employee_code") @db.VarChar(100)
  lastKnownEmail       String?  @map("last_known_email") @db.VarChar(255)
  lastKnownName        String?  @map("last_known_name") @db.VarChar(200)
  lastSyncedAt         DateTime @default(now()) @map("last_synced_at") @db.Timestamptz()
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([sourceSystem, externalUserId])
  @@index([employeeId])
  @@index([lastKnownEmail])
  @@map("external_employee_identities")
}

// Một nhân sự có thể thuộc nhiều team. Employee.teamId chỉ còn là team chính (giữ cho consumer cũ);
// dữ liệu nghiệp vụ mới phải đi qua membership.
model EmployeeTeamMembership {
  id                         Int       @id @default(autoincrement())
  employeeId                 Int       @map("employee_id")
  teamId                     Int       @map("team_id")
  isPrimary                  Boolean   @default(false) @map("is_primary")
  defaultSalaryWeightPercent Decimal   @default(100) @map("default_salary_weight_percent") @db.Decimal(5, 2)
  leaderEmployeeId           Int?      @map("leader_employee_id")
  managerEmployeeId          Int?      @map("manager_employee_id")
  joinedAt                   DateTime? @map("joined_at") @db.Date
  leftAt                     DateTime? @map("left_at") @db.Date
  isActive                   Boolean   @default(true) @map("is_active")
  sourceSystem               String?   @map("source_system") @db.VarChar(30)
  externalTeamId             String?   @map("external_team_id") @db.Uuid
  lastSyncedAt               DateTime? @map("last_synced_at") @db.Timestamptz()
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                  DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  employee        Employee                            @relation("MembershipEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  team            Team                                @relation(fields: [teamId], references: [id], onDelete: Restrict)
  leader          Employee?                           @relation("MembershipLeader", fields: [leaderEmployeeId], references: [id], onDelete: SetNull)
  manager         Employee?                           @relation("MembershipManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  periodSnapshots PayrollPeriodEmployeeTeamSnapshot[]

  // Migration còn có partial unique index (is_primary = true AND is_active = true) bảo đảm mỗi
  // nhân sự chỉ có tối đa một team chính đang hoạt động — ràng buộc này Prisma không biểu diễn được.
  @@unique([employeeId, teamId])
  @@index([teamId, isActive])
  @@index([employeeId, isActive])
  @@index([leaderEmployeeId])
  @@index([managerEmployeeId])
  @@map("employee_team_memberships")
}

model Role {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(80)
  name         String   @db.VarChar(150)
  description  String?
  isSystemRole Boolean  @default(false) @map("is_system_role")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  userRoles                UserRole[]
  rolePermissions          RolePermission[]
  defaultForEmployeeGroups EmployeeGroup[]

  @@map("roles")
}

model Permission {
  id          Int     @id @default(autoincrement())
  code        String  @unique @db.VarChar(120)
  name        String  @db.VarChar(150)
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id          Int       @id @default(autoincrement())
  userId      String    @map("user_id") @db.Uuid
  roleId      Int       @map("role_id")
  scopeType   ScopeType @map("scope_type")
  scopeTeamId Int?      @map("scope_team_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  scopeTeam Team? @relation(fields: [scopeTeamId], references: [id])

  // Migration dùng NULLS NOT DISTINCT để scopeTeamId = null vẫn thật sự unique trên PostgreSQL.
  @@unique([userId, roleId, scopeType, scopeTeamId])
  @@map("user_roles")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model OrgSyncRun {
  id                String        @id @default(uuid()) @db.Uuid
  externalTeamId    String        @map("external_team_id") @db.Uuid
  triggeredByUserId String?       @map("triggered_by_user_id") @db.Uuid
  status            OrgSyncStatus @default(RUNNING)
  startedAt         DateTime      @default(now()) @map("started_at") @db.Timestamptz()
  finishedAt        DateTime?     @map("finished_at") @db.Timestamptz()
  totalRecords      Int           @default(0) @map("total_records")
  successfulRecords Int           @default(0) @map("successful_records")
  failedRecords     Int           @default(0) @map("failed_records")
  errorSummary      String?       @map("error_summary")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  items       OrgSyncRunItem[]
  triggeredBy User?            @relation(fields: [triggeredByUserId], references: [id])

  @@index([startedAt(sort: Desc)])
  @@map("org_sync_runs")
}

model OrgSyncRunItem {
  id                Int               @id @default(autoincrement())
  orgSyncRunId      String            @map("org_sync_run_id") @db.Uuid
  externalRecordKey String            @map("external_record_key") @db.VarChar(200)
  employeeId        Int?              @map("employee_id")
  resultStatus      OrgSyncItemStatus @map("result_status")
  errorMessage      String?           @map("error_message")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz()

  run      OrgSyncRun @relation(fields: [orgSyncRunId], references: [id], onDelete: Cascade)
  employee Employee?  @relation(fields: [employeeId], references: [id])

  @@index([orgSyncRunId, createdAt])
  @@map("org_sync_run_items")
}

model FileAttachment {
  id               String   @id @default(uuid()) @db.Uuid
  uploadedByUserId String   @map("uploaded_by_user_id") @db.Uuid
  originalFileName String   @map("original_file_name") @db.VarChar(255)
  mimeType         String   @map("mime_type") @db.VarChar(120)
  fileSizeBytes    BigInt   @map("file_size_bytes")
  // Object key trong bucket Supabase Storage (private) — chỉ dùng để tạo signed URL, không trả
  // thẳng ra API response.
  storageKey       String   @map("storage_key")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  uploadedBy     User                      @relation(fields: [uploadedByUserId], references: [id])
  trafficRecords TrafficRecordAttachment[]

  @@map("file_attachments")
}

model PayrollPeriod {
  id               Int                 @id @default(autoincrement())
  code             String              @unique @db.VarChar(20)
  name             String              @db.VarChar(100)
  payrollYear      Int                 @map("payroll_year")
  payrollMonth     Int                 @map("payroll_month")
  startDate        DateTime            @map("start_date") @db.Date
  endDate          DateTime            @map("end_date") @db.Date
  approvalDeadline DateTime?           @map("approval_deadline") @db.Timestamptz()
  // Gán tự động bằng RewardRuleSet đang ACTIVE lúc mở kỳ và giữ nguyên vĩnh viễn, kể cả khi
  // sau này có version ACTIVE khác.
  rewardRuleSetId  Int?                @map("reward_rule_set_id")
  status           PayrollPeriodStatus @default(DRAFT)
  openedByUserId   String?             @map("opened_by_user_id") @db.Uuid
  openedAt         DateTime?           @map("opened_at") @db.Timestamptz()
  closedAt         DateTime?           @map("closed_at") @db.Timestamptz()
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz()

  openedBy               User?                               @relation(fields: [openedByUserId], references: [id])
  rewardRuleSet          RewardRuleSet?                      @relation("PayrollPeriodRewardRuleSet", fields: [rewardRuleSetId], references: [id])
  employeeSnapshots      PayrollPeriodEmployeeSnapshot[]
  employeeTeamSnapshots  PayrollPeriodEmployeeTeamSnapshot[]
  auditLogs              AuditLog[]
  employeeRevenueRecords EmployeeRevenueRecord[]
  employeeTrafficRecords EmployeeTrafficRecord[]
  kpiPeriodTargets       KpiPeriodTarget[]
  employeeKpiTargets     EmployeeKpiTarget[]
  kpiAssignments         EmployeeKpiAssignment[]
  kpiActuals             EmployeeKpiActual[]
  okrs                   EmployeeOkr[]
  proposals              KpiOkrProposal[]
  kpiSyncRuns            KpiSyncRun[]
  salaryRecords          SalaryRecord[]

  // Chiều ngược của RewardRuleSet.effectiveFromPeriodId — không dùng để truy vấn, chỉ tồn tại
  // vì Prisma bắt khai báo hai chiều cho relation có tên.
  effectiveForRewardRuleSets RewardRuleSet[] @relation("RewardRuleSetEffectiveFromPeriod")

  @@unique([payrollYear, payrollMonth])
  @@index([startDate(sort: Desc)])
  @@map("payroll_periods")
}

// Nguồn doanh thu DUY NHẤT mà Salary Engine dùng để tra mốc hoa hồng — dữ liệu đối chiếu từ
// bên ngoài không được ghi vào đây.
model EmployeeRevenueRecord {
  id                    Int      @id @default(autoincrement())
  employeeId            Int      @map("employee_id")
  payrollPeriodId       Int      @map("payroll_period_id")
  officialRevenueAmount Decimal  @map("official_revenue_amount") @db.Decimal(18, 0)
  enteredByUserId       String   @map("entered_by_user_id") @db.Uuid
  enteredAt             DateTime @default(now()) @map("entered_at") @db.Timestamptz()
  updatedByUserId       String?  @map("updated_by_user_id") @db.Uuid
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  employee      Employee      @relation(fields: [employeeId], references: [id])
  payrollPeriod PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])
  enteredBy     User          @relation("RevenueEnteredBy", fields: [enteredByUserId], references: [id])
  updatedBy     User?         @relation("RevenueUpdatedBy", fields: [updatedByUserId], references: [id])

  @@unique([employeeId, payrollPeriodId])
  @@index([payrollPeriodId])
  @@map("employee_revenue_records")
}

// Chỉ record đã CONFIRMED và được leader APPROVED mới được tính traffic hợp lệ cho RPM.
model EmployeeTrafficRecord {
  id                     Int                    @id @default(autoincrement())
  employeeId             Int                    @map("employee_id")
  payrollPeriodId        Int                    @map("payroll_period_id")
  platform               TrafficPlatform
  views                  BigInt                 @default(0)
  selfConfirmationStatus SelfConfirmationStatus @default(DRAFT) @map("self_confirmation_status")
  selfConfirmedByUserId  String?                @map("self_confirmed_by_user_id") @db.Uuid
  selfConfirmedAt        DateTime?              @map("self_confirmed_at") @db.Timestamptz()
  leaderReviewStatus     LeaderReviewStatus     @default(PENDING) @map("leader_review_status")
  leaderReviewedByUserId String?                @map("leader_reviewed_by_user_id") @db.Uuid
  leaderReviewedAt       DateTime?              @map("leader_reviewed_at") @db.Timestamptz()
  leaderRejectionReason  String?                @map("leader_rejection_reason")
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz()

  employee         Employee                  @relation(fields: [employeeId], references: [id])
  payrollPeriod    PayrollPeriod             @relation(fields: [payrollPeriodId], references: [id])
  selfConfirmedBy  User?                     @relation("TrafficSelfConfirmedBy", fields: [selfConfirmedByUserId], references: [id])
  leaderReviewedBy User?                     @relation("TrafficLeaderReviewedBy", fields: [leaderReviewedByUserId], references: [id])
  attachments      TrafficRecordAttachment[]

  @@unique([employeeId, payrollPeriodId, platform])
  @@index([payrollPeriodId])
  @@map("employee_traffic_records")
}

model TrafficRecordAttachment {
  employeeTrafficRecordId Int    @map("employee_traffic_record_id")
  fileAttachmentId        String @map("file_attachment_id") @db.Uuid

  employeeTrafficRecord EmployeeTrafficRecord @relation(fields: [employeeTrafficRecordId], references: [id], onDelete: Cascade)
  // Restrict (không cascade từ file): minh chứng đã gắn phải được gỡ tường minh, tránh mất bằng
  // chứng của dữ liệu đã xác nhận/duyệt.
  fileAttachment        FileAttachment        @relation(fields: [fileAttachmentId], references: [id], onDelete: Restrict)

  @@id([employeeTrafficRecordId, fileAttachmentId])
  @@index([fileAttachmentId])
  @@map("traffic_record_attachments")
}

// Snapshot chốt tại thời điểm mở kỳ và BẤT BIẾN — không tự cập nhật khi nhân sự đổi
// team/leader/manager về sau.
model PayrollPeriodEmployeeSnapshot {
  id                        Int      @id @default(autoincrement())
  payrollPeriodId           Int      @map("payroll_period_id")
  employeeId                Int      @map("employee_id")
  employeeCodeSnapshot      String   @map("employee_code_snapshot") @db.VarChar(50)
  employeeNameSnapshot      String   @map("employee_name_snapshot") @db.VarChar(200)
  jobTitleSnapshot          String   @map("job_title_snapshot") @db.VarChar(100)
  employeeGroupsSnapshot    String[] @default([]) @map("employee_groups_snapshot")
  teamIdSnapshot            Int?     @map("team_id_snapshot")
  teamCodeSnapshot          String?  @map("team_code_snapshot") @db.VarChar(50)
  teamNameSnapshot          String?  @map("team_name_snapshot") @db.VarChar(150)
  leaderEmployeeIdSnapshot  Int?     @map("leader_employee_id_snapshot")
  leaderNameSnapshot        String?  @map("leader_name_snapshot") @db.VarChar(200)
  managerEmployeeIdSnapshot Int?     @map("manager_employee_id_snapshot")
  managerNameSnapshot       String?  @map("manager_name_snapshot") @db.VarChar(200)
  employmentStatusSnapshot  String   @map("employment_status_snapshot") @db.VarChar(20)
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz()

  payrollPeriod PayrollPeriod                       @relation(fields: [payrollPeriodId], references: [id])
  employee      Employee                            @relation(fields: [employeeId], references: [id])
  teamSnapshots PayrollPeriodEmployeeTeamSnapshot[]

  @@unique([payrollPeriodId, employeeId])
  @@index([payrollPeriodId, teamIdSnapshot])
  @@index([payrollPeriodId, employeeNameSnapshot], map: "payroll_period_snapshots_period_employee_name_idx")
  @@map("payroll_period_employee_snapshots")
}

// Snapshot bất biến của từng membership. salaryWeightPercent là tỷ trọng KPI của team trong kỳ
// và không đổi theo cấu trúc tổ chức live sau đó.
model PayrollPeriodEmployeeTeamSnapshot {
  id                        Int      @id @default(autoincrement())
  payrollPeriodId           Int      @map("payroll_period_id")
  employeeSnapshotId        Int      @map("employee_snapshot_id")
  employeeId                Int      @map("employee_id")
  membershipId              Int?     @map("membership_id")
  teamId                    Int      @map("team_id")
  teamCodeSnapshot          String   @map("team_code_snapshot") @db.VarChar(50)
  teamNameSnapshot          String   @map("team_name_snapshot") @db.VarChar(150)
  isPrimary                 Boolean  @default(false) @map("is_primary")
  salaryWeightPercent       Decimal  @default(100) @map("salary_weight_percent") @db.Decimal(5, 2)
  leaderEmployeeIdSnapshot  Int?     @map("leader_employee_id_snapshot")
  leaderNameSnapshot        String?  @map("leader_name_snapshot") @db.VarChar(200)
  managerEmployeeIdSnapshot Int?     @map("manager_employee_id_snapshot")
  managerNameSnapshot       String?  @map("manager_name_snapshot") @db.VarChar(200)
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz()

  payrollPeriod    PayrollPeriod                 @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employeeSnapshot PayrollPeriodEmployeeSnapshot @relation(fields: [employeeSnapshotId], references: [id], onDelete: Cascade)
  employee         Employee                      @relation("PeriodTeamSnapshotEmployee", fields: [employeeId], references: [id])
  membership       EmployeeTeamMembership?       @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  team             Team                          @relation(fields: [teamId], references: [id])
  leader           Employee?                     @relation("PeriodTeamSnapshotLeader", fields: [leaderEmployeeIdSnapshot], references: [id], onDelete: SetNull)
  manager          Employee?                     @relation("PeriodTeamSnapshotManager", fields: [managerEmployeeIdSnapshot], references: [id], onDelete: SetNull)

  @@unique([payrollPeriodId, employeeId, teamId])
  @@index([payrollPeriodId, teamId])
  @@index([employeeSnapshotId])
  @@map("payroll_period_employee_team_snapshots")
}

// Mỗi version là một snapshot cấu hình thưởng. Bản ACTIVE bất biến: muốn đổi rule phải clone
// sang DRAFT rồi activate, và activate sẽ tự ARCHIVED bản ACTIVE cũ.
model RewardRuleSet {
  id                          Int                 @id @default(autoincrement())
  version                     Int                 @unique
  achievementThresholdPercent Decimal             @map("achievement_threshold_percent") @db.Decimal(5, 2)
  // Chỉ là ghi chú "áp dụng từ kỳ nào", KHÔNG phải cơ chế gán rule set cho kỳ — việc gán do
  // PayrollPeriod.rewardRuleSetId đảm nhiệm lúc mở kỳ.
  effectiveFromPeriodId       Int?                @map("effective_from_period_id")
  status                      RewardRuleSetStatus @default(DRAFT)
  createdByUserId             String              @map("created_by_user_id") @db.Uuid
  createdAt                   DateTime            @default(now()) @map("created_at") @db.Timestamptz()

  effectiveFromPeriod PayrollPeriod?         @relation("RewardRuleSetEffectiveFromPeriod", fields: [effectiveFromPeriodId], references: [id])
  createdBy           User                   @relation(fields: [createdByUserId], references: [id])
  revenueBrackets     RevenueRewardBracket[]
  payrollPeriods      PayrollPeriod[]        @relation("PayrollPeriodRewardRuleSet")
  salaryRecords       SalaryRecord[]

  // Migration có partial unique index (WHERE status = 'ACTIVE') bảo đảm tối đa một bản ACTIVE.
  @@map("reward_rule_sets")
}

// Match theo nửa khoảng [minRevenueAmount, maxRevenueAmount); bracket cao nhất có max = null.
// Chỉ sửa được khi rule set còn DRAFT.
model RevenueRewardBracket {
  id                    Int      @id @default(autoincrement())
  rewardRuleSetId       Int      @map("reward_rule_set_id")
  label                 String   @db.VarChar(120)
  minRevenueAmount      Decimal  @map("min_revenue_amount") @db.Decimal(18, 0)
  maxRevenueAmount      Decimal? @map("max_revenue_amount") @db.Decimal(18, 0)
  commissionRatePercent Decimal  @map("commission_rate_percent") @db.Decimal(7, 4)
  rpmRatePer1000Views   Decimal  @map("rpm_rate_per_1000_views") @db.Decimal(18, 4)
  sortOrder             Int      @map("sort_order")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz()

  rewardRuleSet RewardRuleSet  @relation(fields: [rewardRuleSetId], references: [id], onDelete: Cascade)
  salaryRecords SalaryRecord[]

  @@unique([rewardRuleSetId, sortOrder])
  @@map("revenue_reward_brackets")
}

// Lịch sử theo nửa khoảng [effectiveFrom, effectiveTo); bản hiện hành có effectiveTo = null và
// được service tự đóng lại khi tạo bản mới. V1 chưa prorate theo ngày công.
model BaseSalaryHistory {
  id                Int       @id @default(autoincrement())
  employeeId        Int       @map("employee_id")
  monthlyBaseSalary Decimal   @map("monthly_base_salary") @db.Decimal(18, 0)
  effectiveFrom     DateTime  @map("effective_from") @db.Date
  effectiveTo       DateTime? @map("effective_to") @db.Date
  createdByUserId   String    @map("created_by_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  employee  Employee @relation(fields: [employeeId], references: [id])
  createdBy User     @relation(fields: [createdByUserId], references: [id])

  @@index([employeeId, effectiveFrom(sort: Desc)])
  @@map("base_salary_histories")
}

// Cùng cơ chế nửa khoảng như BaseSalaryHistory. Salary engine resolve bản có hiệu lực rồi
// snapshot rewardAmount vào salary record.
model EmployeeKpiRewardRate {
  id              Int       @id @default(autoincrement())
  employeeId      Int       @map("employee_id")
  kpiGroupId      Int       @map("kpi_group_id")
  rewardAmount    Decimal   @map("reward_amount") @db.Decimal(18, 0)
  effectiveFrom   DateTime  @map("effective_from") @db.Date
  effectiveTo     DateTime? @map("effective_to") @db.Date
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  employee  Employee @relation(fields: [employeeId], references: [id])
  kpiGroup  KpiGroup @relation(fields: [kpiGroupId], references: [id])
  createdBy User     @relation(fields: [createdByUserId], references: [id])

  @@unique([employeeId, kpiGroupId, effectiveFrom])
  @@index([employeeId, effectiveFrom(sort: Desc)])
  @@index([kpiGroupId])
  @@map("employee_kpi_reward_rates")
}

model KpiGroup {
  id              Int           @id @default(autoincrement())
  code            String        @unique @db.VarChar(80)
  name            String        @db.VarChar(200)
  description     String?
  dataSource      KpiDataSource @default(INTERNAL) @map("data_source")
  isActive        Boolean       @default(true) @map("is_active")
  createdByUserId String        @map("created_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  createdBy                User            @relation(fields: [createdByUserId], references: [id])
  // Rỗng chỉ còn ở dữ liệu cũ và được hiểu là dùng chung toàn hệ thống; nhóm mới bắt buộc chọn team.
  teams                    Team[]          @relation("KpiGroupTeams")
  // Rỗng = chỉ gán thủ công. Có giá trị = tự gán khi mở kỳ cho nhân sự khớp ít nhất một nhóm.
  applicableEmployeeGroups EmployeeGroup[] @relation("KpiGroupEmployeeGroups")

  items       KpiItem[]
  assignments EmployeeKpiAssignment[]
  rewardRates EmployeeKpiRewardRate[]
  salaryItems SalaryRecordKpiItem[]
  proposals   KpiOkrProposal[]

  @@map("kpi_groups")
}

// Định nghĩa cố định của một đầu mục; target không nằm ở đây mà ở KpiPeriodTarget vì target
// thay đổi theo từng kỳ. `code` do hệ thống sinh và bất biến sau khi tạo.
model KpiItem {
  id         Int      @id @default(autoincrement())
  kpiGroupId Int      @map("kpi_group_id")
  code       String   @db.VarChar(80)
  name       String   @db.VarChar(200)
  unit       String   @db.VarChar(50)
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  kpiGroup        KpiGroup            @relation(fields: [kpiGroupId], references: [id])
  periodTargets   KpiPeriodTarget[]
  employeeTargets EmployeeKpiTarget[]
  employeeActuals EmployeeKpiActual[]
  syncItems       KpiSyncRunItem[]

  @@unique([kpiGroupId, code])
  @@map("kpi_items")
}

// Target mặc định của một KpiItem trong một kỳ. Mỗi kỳ độc lập; set qua PUT (upsert, idempotent).
model KpiPeriodTarget {
  id              Int      @id @default(autoincrement())
  kpiItemId       Int      @map("kpi_item_id")
  payrollPeriodId Int      @map("payroll_period_id")
  targetValue     Decimal  @map("target_value") @db.Decimal(18, 4)
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  kpiItem       KpiItem       @relation(fields: [kpiItemId], references: [id])
  payrollPeriod PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])
  createdBy     User          @relation(fields: [createdByUserId], references: [id])

  @@unique([kpiItemId, payrollPeriodId])
  @@index([payrollPeriodId])
  @@map("kpi_period_targets")
}

// Target riêng của một nhân sự. Khi tồn tại, bản ghi này được ưu tiên hơn KpiPeriodTarget lúc
// tính tiến độ, nhưng KHÔNG ghi đè cấu hình chung của kỳ.
model EmployeeKpiTarget {
  id                 Int                @id @default(autoincrement())
  employeeId         Int                @map("employee_id")
  kpiItemId          Int                @map("kpi_item_id")
  payrollPeriodId    Int                @map("payroll_period_id")
  teamId             Int                @map("team_id")
  targetValue        Decimal            @map("target_value") @db.Decimal(18, 4)
  overrideValue      Decimal?           @map("override_value") @db.Decimal(18, 4)
  overrideReason     String?            @map("override_reason")
  overriddenByUserId String?            @map("overridden_by_user_id") @db.Uuid
  overriddenAt       DateTime?          @map("overridden_at") @db.Timestamptz()
  dataSource         KpiValueDataSource @default(MANUAL) @map("data_source")
  syncedAt           DateTime?          @map("synced_at") @db.Timestamptz()
  createdByUserId    String             @map("created_by_user_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz()

  employee      Employee         @relation(fields: [employeeId], references: [id])
  kpiItem       KpiItem          @relation(fields: [kpiItemId], references: [id])
  payrollPeriod PayrollPeriod    @relation(fields: [payrollPeriodId], references: [id])
  team          Team             @relation(fields: [teamId], references: [id])
  createdBy     User             @relation(fields: [createdByUserId], references: [id])
  overriddenBy  User?            @relation("KpiTargetOverriddenBy", fields: [overriddenByUserId], references: [id])
  syncItems     KpiSyncRunItem[]

  @@unique([employeeId, teamId, kpiItemId, payrollPeriodId])
  @@index([employeeId, payrollPeriodId, teamId])
  @@index([payrollPeriodId, kpiItemId])
  @@map("employee_kpi_targets")
}

// Điều kiện bắt buộc để nhân sự được nhập actual cho các item của group trong kỳ. Khi tạo,
// service sinh kèm EmployeeKpiActual (0/DRAFT/PENDING) cho mọi KpiItem đang active của group.
model EmployeeKpiAssignment {
  id               Int                 @id @default(autoincrement())
  employeeId       Int                 @map("employee_id")
  kpiGroupId       Int                 @map("kpi_group_id")
  payrollPeriodId  Int                 @map("payroll_period_id")
  teamId           Int                 @map("team_id")
  assignmentStatus KpiAssignmentStatus @default(ASSIGNED) @map("assignment_status")
  assignedByUserId String              @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime            @default(now()) @map("assigned_at") @db.Timestamptz()

  employee      Employee      @relation(fields: [employeeId], references: [id])
  kpiGroup      KpiGroup      @relation(fields: [kpiGroupId], references: [id])
  payrollPeriod PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])
  team          Team          @relation(fields: [teamId], references: [id])
  assignedBy    User          @relation("KpiAssignmentAssignedBy", fields: [assignedByUserId], references: [id])

  @@unique([employeeId, teamId, kpiGroupId, payrollPeriodId])
  @@index([payrollPeriodId, employeeId, teamId])
  @@index([kpiGroupId])
  @@map("employee_kpi_assignments")
}

// Giá trị salary engine dùng là effective actual = overrideValue ?? actualValue.
// actualValue/selfAssessment chỉ sửa được khi selfConfirmationStatus = DRAFT.
model EmployeeKpiActual {
  id                     Int                    @id @default(autoincrement())
  employeeId             Int                    @map("employee_id")
  kpiItemId              Int                    @map("kpi_item_id")
  payrollPeriodId        Int                    @map("payroll_period_id")
  teamId                 Int                    @map("team_id")
  actualValue            Decimal                @default(0) @map("actual_value") @db.Decimal(18, 4)
  dataSource             KpiValueDataSource     @default(MANUAL) @map("data_source")
  syncedAt               DateTime?              @map("synced_at") @db.Timestamptz()
  requiresManualEntry    Boolean                @default(false) @map("requires_manual_entry")
  manualEnteredAt        DateTime?              @map("manual_entered_at") @db.Timestamptz()
  syncMessage            String?                @map("sync_message")
  selfAssessment         String?                @map("self_assessment")
  selfConfirmationStatus SelfConfirmationStatus @default(DRAFT) @map("self_confirmation_status")
  selfConfirmedByUserId  String?                @map("self_confirmed_by_user_id") @db.Uuid
  selfConfirmedAt        DateTime?              @map("self_confirmed_at") @db.Timestamptz()
  leaderReviewStatus     LeaderReviewStatus     @default(PENDING) @map("leader_review_status")
  leaderReviewedByUserId String?                @map("leader_reviewed_by_user_id") @db.Uuid
  leaderReviewedAt       DateTime?              @map("leader_reviewed_at") @db.Timestamptz()
  leaderRejectionReason  String?                @map("leader_rejection_reason")
  overrideValue          Decimal?               @map("override_value") @db.Decimal(18, 4)
  overrideReason         String?                @map("override_reason")
  overriddenByUserId     String?                @map("overridden_by_user_id") @db.Uuid
  overriddenAt           DateTime?              @map("overridden_at") @db.Timestamptz()
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz()

  employee         Employee         @relation(fields: [employeeId], references: [id])
  kpiItem          KpiItem          @relation(fields: [kpiItemId], references: [id])
  payrollPeriod    PayrollPeriod    @relation(fields: [payrollPeriodId], references: [id])
  team             Team             @relation(fields: [teamId], references: [id])
  selfConfirmedBy  User?            @relation("KpiActualSelfConfirmedBy", fields: [selfConfirmedByUserId], references: [id])
  leaderReviewedBy User?            @relation("KpiActualLeaderReviewedBy", fields: [leaderReviewedByUserId], references: [id])
  overriddenBy     User?            @relation("KpiActualOverriddenBy", fields: [overriddenByUserId], references: [id])
  syncItems        KpiSyncRunItem[]

  @@unique([employeeId, teamId, kpiItemId, payrollPeriodId])
  @@index([employeeId, payrollPeriodId, teamId])
  @@index([kpiItemId])
  @@map("employee_kpi_actuals")
}

model KpiSyncRun {
  id                String        @id @default(uuid()) @db.Uuid
  externalTeamId    String        @map("external_team_id") @db.Uuid
  payrollPeriodId   Int           @map("payroll_period_id")
  month             String        @db.VarChar(7)
  triggeredByUserId String        @map("triggered_by_user_id") @db.Uuid
  status            KpiSyncStatus @default(RUNNING)
  startedAt         DateTime      @default(now()) @map("started_at") @db.Timestamptz()
  finishedAt        DateTime?     @map("finished_at") @db.Timestamptz()
  receivedRecords   Int           @default(0) @map("received_records")
  successfulRecords Int           @default(0) @map("successful_records")
  skippedRecords    Int           @default(0) @map("skipped_records")
  conflictRecords   Int           @default(0) @map("conflict_records")
  failedRecords     Int           @default(0) @map("failed_records")
  manualEntryCount  Int           @default(0) @map("manual_entry_count")
  warningCount      Int           @default(0) @map("warning_count")
  sourceWarnings    Json?         @map("source_warnings")
  errorSummary      String?       @map("error_summary")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  payrollPeriod PayrollPeriod    @relation(fields: [payrollPeriodId], references: [id])
  triggeredBy   User             @relation(fields: [triggeredByUserId], references: [id])
  items         KpiSyncRunItem[]

  // Migration có thêm partial unique index (WHERE status = 'RUNNING') để không thể có hai run
  // đang chạy cùng team/tháng.
  @@index([startedAt(sort: Desc)])
  @@index([externalTeamId, month, status])
  @@index([payrollPeriodId])
  @@map("kpi_sync_runs")
}

model KpiSyncRunItem {
  id                   Int               @id @default(autoincrement())
  kpiSyncRunId         String            @map("kpi_sync_run_id") @db.Uuid
  externalRecordKey    String            @map("external_record_key") @db.VarChar(300)
  externalUserId       String?           @map("external_user_id") @db.Uuid
  externalEmployeeCode String?           @map("external_employee_code") @db.VarChar(50)
  employeeId           Int?              @map("employee_id")
  teamId               Int?              @map("team_id")
  kpiItemId            Int?              @map("kpi_item_id")
  employeeKpiTargetId  Int?              @map("employee_kpi_target_id")
  employeeKpiActualId  Int?              @map("employee_kpi_actual_id")
  groupCode            String            @map("group_code") @db.VarChar(80)
  metricCode           String            @map("metric_code") @db.VarChar(80)
  recordKind           KpiSyncRecordKind @map("record_kind")
  resultStatus         KpiSyncItemStatus @map("result_status")
  previousValue        Decimal?          @map("previous_value") @db.Decimal(18, 4)
  incomingValue        Decimal?          @map("incoming_value") @db.Decimal(18, 4)
  appliedValue         Decimal?          @map("applied_value") @db.Decimal(18, 4)
  hasConflict          Boolean           @default(false) @map("has_conflict")
  manualEntryRequired  Boolean           @default(false) @map("manual_entry_required")
  message              String?
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz()

  run               KpiSyncRun         @relation(fields: [kpiSyncRunId], references: [id], onDelete: Cascade)
  employee          Employee?          @relation(fields: [employeeId], references: [id])
  team              Team?              @relation(fields: [teamId], references: [id])
  kpiItem           KpiItem?           @relation(fields: [kpiItemId], references: [id])
  employeeKpiTarget EmployeeKpiTarget? @relation(fields: [employeeKpiTargetId], references: [id])
  employeeKpiActual EmployeeKpiActual? @relation(fields: [employeeKpiActualId], references: [id])

  @@index([kpiSyncRunId, resultStatus, id])
  @@index([employeeId, resultStatus, id(sort: Desc)], map: "kpi_sync_run_items_employee_status_id_idx")
  // Cần cho ON DELETE SET NULL khi xóa KPI item chưa phát sinh dữ liệu nghiệp vụ.
  @@index([kpiItemId])
  @@index([teamId, employeeId])
  @@map("kpi_sync_run_items")
}

// Không có bảng assignment riêng như KPI: Leader/Admin tạo thẳng OKR kèm target và rewardAmount,
// nhân sự chỉ tự cập nhật actualValue/selfAssessment khi còn DRAFT.
// progress = MIN(actual/target, 100%) tính động ở API, không lưu cột riêng.
model EmployeeOkr {
  id                     Int                    @id @default(autoincrement())
  employeeId             Int                    @map("employee_id")
  payrollPeriodId        Int                    @map("payroll_period_id")
  title                  String                 @db.VarChar(250)
  description            String?
  unit                   String?                @db.VarChar(50)
  targetValue            Decimal                @map("target_value") @db.Decimal(18, 4)
  actualValue            Decimal                @default(0) @map("actual_value") @db.Decimal(18, 4)
  overrideValue          Decimal?               @map("override_value") @db.Decimal(18, 4)
  overrideReason         String?                @map("override_reason")
  rewardAmount           Decimal                @map("reward_amount") @db.Decimal(18, 0)
  deadline               DateTime?              @db.Date
  selfAssessment         String?                @map("self_assessment")
  selfConfirmationStatus SelfConfirmationStatus @default(DRAFT) @map("self_confirmation_status")
  selfConfirmedByUserId  String?                @map("self_confirmed_by_user_id") @db.Uuid
  selfConfirmedAt        DateTime?              @map("self_confirmed_at") @db.Timestamptz()
  leaderReviewStatus     LeaderReviewStatus     @default(PENDING) @map("leader_review_status")
  leaderReviewedByUserId String?                @map("leader_reviewed_by_user_id") @db.Uuid
  leaderReviewedAt       DateTime?              @map("leader_reviewed_at") @db.Timestamptz()
  leaderRejectionReason  String?                @map("leader_rejection_reason")
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz()

  employee         Employee              @relation(fields: [employeeId], references: [id])
  payrollPeriod    PayrollPeriod         @relation(fields: [payrollPeriodId], references: [id])
  selfConfirmedBy  User?                 @relation("OkrSelfConfirmedBy", fields: [selfConfirmedByUserId], references: [id])
  leaderReviewedBy User?                 @relation("OkrLeaderReviewedBy", fields: [leaderReviewedByUserId], references: [id])
  salaryItems      SalaryRecordOkrItem[]

  @@index([employeeId, payrollPeriodId, createdAt])
  @@map("employee_okrs")
}

// Approve OKR: tự tạo EmployeeOkr và ghi lại ở resultEntityType/resultEntityId.
// Approve KPI_ITEM: chỉ chuyển status APPROVED, KpiItem vẫn phải tạo tay ở tab Cấu hình KPI.
model KpiOkrProposal {
  id                   Int            @id @default(autoincrement())
  payrollPeriodId      Int            @map("payroll_period_id")
  proposerEmployeeId   Int            @map("proposer_employee_id")
  proposalType         ProposalType   @map("proposal_type")
  proposedKpiGroupId   Int?           @map("proposed_kpi_group_id")
  proposedName         String         @map("proposed_name") @db.VarChar(250)
  proposedUnit         String?        @map("proposed_unit") @db.VarChar(50)
  proposedTargetValue  Decimal        @map("proposed_target_value") @db.Decimal(18, 4)
  proposedRewardAmount Decimal?       @map("proposed_reward_amount") @db.Decimal(18, 0)
  proposedDeadline     DateTime?      @map("proposed_deadline") @db.Date
  reason               String
  status               ProposalStatus @default(PENDING)
  reviewedByUserId     String?        @map("reviewed_by_user_id") @db.Uuid
  reviewedAt           DateTime?      @map("reviewed_at") @db.Timestamptz()
  rejectionReason      String?        @map("rejection_reason")
  resultEntityType     String?        @map("result_entity_type") @db.VarChar(30)
  resultEntityId       Int?           @map("result_entity_id")
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  payrollPeriod    PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])
  proposerEmployee Employee      @relation(fields: [proposerEmployeeId], references: [id])
  proposedKpiGroup KpiGroup?     @relation(fields: [proposedKpiGroupId], references: [id])
  reviewedBy       User?         @relation("ProposalReviewedBy", fields: [reviewedByUserId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@map("kpi_okr_proposals")
}

// Snapshot kết quả tính lương. Chỉ cập nhật được version hiện hành khi còn PENDING/WARNING;
// bản LOCKED bất biến, sửa lại phải tạo revision mới (parentSalaryRecordId).
model SalaryRecord {
  id                            Int                @id @default(autoincrement())
  employeeId                    Int                @map("employee_id")
  payrollPeriodId               Int                @map("payroll_period_id")
  versionNumber                 Int                @default(1) @map("version_number")
  parentSalaryRecordId          Int?               @map("parent_salary_record_id")
  rewardRuleSetId               Int                @map("reward_rule_set_id")
  revenueRewardBracketId        Int?               @map("revenue_reward_bracket_id")
  baseSalaryAmount              Decimal            @map("base_salary_amount") @db.Decimal(18, 0)
  kpiRewardAmount               Decimal            @default(0) @map("kpi_reward_amount") @db.Decimal(18, 0)
  okrRewardAmount               Decimal            @default(0) @map("okr_reward_amount") @db.Decimal(18, 0)
  revenueAmountSnapshot         Decimal            @default(0) @map("revenue_amount_snapshot") @db.Decimal(18, 0)
  commissionRatePercentSnapshot Decimal            @default(0) @map("commission_rate_percent_snapshot") @db.Decimal(7, 4)
  commissionAmount              Decimal            @default(0) @map("commission_amount") @db.Decimal(18, 0)
  totalViewsSnapshot            BigInt             @default(0) @map("total_views_snapshot")
  rpmRatePer1000ViewsSnapshot   Decimal            @default(0) @map("rpm_rate_per_1000_views_snapshot") @db.Decimal(18, 4)
  rpmRewardAmount               Decimal            @default(0) @map("rpm_reward_amount") @db.Decimal(18, 0)
  additionalComponentAmount     Decimal            @default(0) @map("additional_component_amount") @db.Decimal(18, 0)
  totalSalaryAmount             Decimal            @map("total_salary_amount") @db.Decimal(18, 0)
  status                        SalaryRecordStatus @default(PENDING)
  calculationWarnings           Json               @default("[]") @map("calculation_warnings")
  calculatedByUserId            String             @map("calculated_by_user_id") @db.Uuid
  calculatedAt                  DateTime           @default(now()) @map("calculated_at") @db.Timestamptz()
  approvedByUserId              String?            @map("approved_by_user_id") @db.Uuid
  approvedAt                    DateTime?          @map("approved_at") @db.Timestamptz()
  lockedAt                      DateTime?          @map("locked_at") @db.Timestamptz()
  createdAt                     DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                     DateTime           @updatedAt @map("updated_at") @db.Timestamptz()

  employee             Employee                @relation(fields: [employeeId], references: [id])
  payrollPeriod        PayrollPeriod           @relation(fields: [payrollPeriodId], references: [id])
  parent               SalaryRecord?           @relation("SalaryRecordVersions", fields: [parentSalaryRecordId], references: [id])
  revisions            SalaryRecord[]          @relation("SalaryRecordVersions")
  rewardRuleSet        RewardRuleSet           @relation(fields: [rewardRuleSetId], references: [id])
  revenueRewardBracket RevenueRewardBracket?   @relation(fields: [revenueRewardBracketId], references: [id])
  calculatedBy         User                    @relation("SalaryCalculatedBy", fields: [calculatedByUserId], references: [id])
  approvedBy           User?                   @relation("SalaryApprovedBy", fields: [approvedByUserId], references: [id])
  kpiItems             SalaryRecordKpiItem[]
  okrItems             SalaryRecordOkrItem[]
  components           SalaryRecordComponent[]

  @@unique([employeeId, payrollPeriodId, versionNumber])
  @@index([payrollPeriodId, status])
  @@index([parentSalaryRecordId])
  @@map("salary_records")
}

model SalaryRecordKpiItem {
  id                                  Int      @id @default(autoincrement())
  salaryRecordId                      Int      @map("salary_record_id")
  kpiGroupId                          Int      @map("kpi_group_id")
  teamId                              Int      @map("team_id")
  teamNameSnapshot                    String   @map("team_name_snapshot") @db.VarChar(150)
  salaryWeightPercentSnapshot         Decimal  @default(100) @map("salary_weight_percent_snapshot") @db.Decimal(5, 2)
  kpiGroupNameSnapshot                String   @map("kpi_group_name_snapshot") @db.VarChar(200)
  progressPercent                     Decimal  @map("progress_percent") @db.Decimal(7, 4)
  achievementThresholdPercentSnapshot Decimal  @map("achievement_threshold_percent_snapshot") @db.Decimal(5, 2)
  rewardAmountSnapshot                Decimal  @map("reward_amount_snapshot") @db.Decimal(18, 0)
  isAchieved                          Boolean  @map("is_achieved")
  earnedAmount                        Decimal  @map("earned_amount") @db.Decimal(18, 0)
  createdAt                           DateTime @default(now()) @map("created_at") @db.Timestamptz()

  salaryRecord SalaryRecord @relation(fields: [salaryRecordId], references: [id], onDelete: Cascade)
  kpiGroup     KpiGroup     @relation(fields: [kpiGroupId], references: [id])
  team         Team         @relation(fields: [teamId], references: [id])

  @@unique([salaryRecordId, teamId, kpiGroupId])
  @@index([kpiGroupId])
  @@map("salary_record_kpi_items")
}

model SalaryRecordOkrItem {
  id                                  Int      @id @default(autoincrement())
  salaryRecordId                      Int      @map("salary_record_id")
  employeeOkrId                       Int      @map("employee_okr_id")
  okrTitleSnapshot                    String   @map("okr_title_snapshot") @db.VarChar(250)
  progressPercent                     Decimal  @map("progress_percent") @db.Decimal(7, 4)
  achievementThresholdPercentSnapshot Decimal  @map("achievement_threshold_percent_snapshot") @db.Decimal(5, 2)
  rewardAmountSnapshot                Decimal  @map("reward_amount_snapshot") @db.Decimal(18, 0)
  isAchieved                          Boolean  @map("is_achieved")
  earnedAmount                        Decimal  @map("earned_amount") @db.Decimal(18, 0)
  createdAt                           DateTime @default(now()) @map("created_at") @db.Timestamptz()

  salaryRecord SalaryRecord @relation(fields: [salaryRecordId], references: [id], onDelete: Cascade)
  employeeOkr  EmployeeOkr  @relation(fields: [employeeOkrId], references: [id])

  @@unique([salaryRecordId, employeeOkrId])
  @@index([employeeOkrId])
  @@map("salary_record_okr_items")
}

// Cấu phần mở để thêm khoản thủ công mà không phải đổi schema của engine.
model SalaryRecordComponent {
  id              Int                   @id @default(autoincrement())
  salaryRecordId  Int                   @map("salary_record_id")
  componentCode   String?               @map("component_code") @db.VarChar(80)
  componentName   String                @map("component_name") @db.VarChar(150)
  amount          Decimal               @db.Decimal(18, 0)
  note            String?
  source          SalaryComponentSource
  createdByUserId String                @map("created_by_user_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz()

  salaryRecord SalaryRecord @relation(fields: [salaryRecordId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdByUserId], references: [id])

  @@index([salaryRecordId])
  @@map("salary_record_components")
}

// Nhật ký bất biến. Các index bên dưới phục vụ trực tiếp bộ lọc của API xem/xuất CSV theo
// scope SELF/TEAM/ALL.
model AuditLog {
  id                   Int      @id @default(autoincrement())
  actorUserId          String   @map("actor_user_id") @db.Uuid
  action               String   @db.VarChar(120)
  entityType           String   @map("entity_type") @db.VarChar(80)
  entityId             String   @map("entity_id") @db.VarChar(100)
  targetEmployeeId     Int?     @map("target_employee_id")
  payrollPeriodId      Int?     @map("payroll_period_id")
  actorTeamIdSnapshot  Int?     @map("actor_team_id_snapshot")
  targetTeamIdSnapshot Int?     @map("target_team_id_snapshot")
  beforeData           Json?    @map("before_data")
  afterData            Json?    @map("after_data")
  reason               String?
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz()

  actor          User           @relation(fields: [actorUserId], references: [id])
  targetEmployee Employee?      @relation(fields: [targetEmployeeId], references: [id])
  payrollPeriod  PayrollPeriod? @relation(fields: [payrollPeriodId], references: [id])

  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([targetEmployeeId, createdAt(sort: Desc)])
  @@index([payrollPeriodId, createdAt(sort: Desc)])
  @@index([actorTeamIdSnapshot, createdAt(sort: Desc)])
  @@index([targetTeamIdSnapshot, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// referenceEntityId là String vì các entity nghiệp vụ có cả khóa Int lẫn UUID. Quyền xem luôn
// chặn bằng recipientUserId, không dựa vào reference.
model Notification {
  id                  Int       @id @default(autoincrement())
  recipientUserId     String    @map("recipient_user_id") @db.Uuid
  notificationType    String    @map("notification_type") @db.VarChar(80)
  title               String    @db.VarChar(200)
  message             String
  referenceEntityType String?   @map("reference_entity_type") @db.VarChar(80)
  referenceEntityId   String?   @map("reference_entity_id") @db.VarChar(100)
  isRead              Boolean   @default(false) @map("is_read")
  readAt              DateTime? @map("read_at") @db.Timestamptz()
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, isRead, createdAt(sort: Desc)])
  @@index([recipientUserId, createdAt(sort: Desc)])
  @@map("notifications")
}
